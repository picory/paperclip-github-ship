{
  "name": "@picory/paperclip-github-ship",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "GitHub workflow, PR, and merge helper plugin for Paperclip.",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ./esbuild.config.mjs",
    "build:rollup": "rollup -c",
    "dev": "node ./esbuild.config.mjs --watch",
    "dev:ui": "paperclip-plugin-dev-server --root . --ui-dir dist/ui --port 4177",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "github",
    "deploy",
    "pr"
  ],
  "author": "picory",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/picory/paperclip-github-ship.git"
  },
  "homepage": "https://github.com/picory/paperclip-github-ship",
  "bugs": {
    "url": "https://github.com/picory/paperclip-github-ship/issues"
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "^2026.517.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "esbuild": "^0.27.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup": "^4.38.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
